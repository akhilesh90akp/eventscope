// ============================================================
// EventScope — Firestore Security Rules (multi-tenant)
//
// This file is NOT auto-deployed by this repo (Vite doesn't touch it) —
// paste it into Firebase Console → Firestore Database → Rules, or deploy
// via `firebase deploy --only firestore:rules`. Keep it in sync with the
// paths used in src/context/AppContext.jsx:
//
//   platformAdmins/{uid}                  EventScope staff (managed in console)
//   users/{uid}                           { tenantId, role: 'owner'|'staff', name, email }
//   tenants/{tenantId}                    { name, plan, status: 'active'|'suspended', ownerUid, createdAt }
//   tenants/{tenantId}/config/settings    company profile, bank, invoice settings
//   tenants/{tenantId}/config/categories  service categories
//   tenants/{tenantId}/events/{eventId}   one doc per event/draft
//
// Isolation: a signed-in user can only reach the tenant named in their own
// users/{uid} doc. Plan/status live on the tenant doc, which only platform
// admins can write — a company can't upgrade or un-suspend itself.
// Suspended tenants are read-only. Staff can't change settings/categories.
// Tests: tests/firestore.rules.test.js (run against the emulator).
// ============================================================
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() {
      return request.auth != null;
    }
    function isPlatformAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid));
    }
    function hasProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isMember(tenantId) {
      return hasProfile() && me().tenantId == tenantId;
    }
    function isOwner(tenantId) {
      return isMember(tenantId) && me().role == 'owner';
    }
    function tenantActive(tenantId) {
      return get(/databases/$(database)/documents/tenants/$(tenantId)).data.status == 'active';
    }

    // ---------- platform admins (EventScope staff) ----------
    // Added/removed by hand in the Firebase console, never from the app.
    match /platformAdmins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ---------- user → tenant membership ----------
    // Read: yourself, the owner of your tenant (team list), or a platform admin.
    // Write: platform admins only for now. Step 4 (add teammates) and step 7
    // (public sign-up) will add owner-invite and self-signup paths here.
    match /users/{uid} {
      allow read: if signedIn() && (
        request.auth.uid == uid
        || isPlatformAdmin()
        || isOwner(resource.data.tenantId)
      );
      allow write: if isPlatformAdmin();
    }

    // ---------- tenants ----------
    match /tenants/{tenantId} {
      allow read: if isMember(tenantId) || isPlatformAdmin();
      allow write: if isPlatformAdmin();

      // Company profile, bank details, invoice settings, categories: owner only.
      match /config/{docId} {
        allow read: if isMember(tenantId) || isPlatformAdmin();
        allow write: if (isOwner(tenantId) && tenantActive(tenantId)) || isPlatformAdmin();
      }

      // Events/drafts: any member, while the tenant is active.
      match /events/{eventId} {
        allow read: if isMember(tenantId) || isPlatformAdmin();
        allow write: if (isMember(tenantId) && tenantActive(tenantId)) || isPlatformAdmin();
      }
    }
  }
}
