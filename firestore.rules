// ============================================================
// EventScope — Firestore Security Rules (multi-tenant)
//
// This file is NOT auto-deployed by this repo (Vite doesn't touch it) —
// paste it into Firebase Console → Firestore Database → Rules, or deploy
// via `firebase deploy --only firestore:rules`. Keep it in sync with the
// paths used in src/context/AppContext.jsx:
//
//   platformAdmins/{uid}                  EventScope staff (managed in console)
//   users/{uid}                           { tenantId, role: 'owner'|'staff', name, email }
//   invites/{email}                       pending teammate invite { tenantId, role: 'staff', ... }
//   tenants/{tenantId}                    { name, plan, status: 'active'|'suspended', ownerUid, createdAt }
//   tenants/{tenantId}/config/settings    company profile, bank, invoice settings
//   tenants/{tenantId}/config/categories  service categories
//   tenants/{tenantId}/events/{eventId}   one doc per event/draft
//   tenants/{tenantId}/config/jobLog      Job Log columns (owner-editable, like all config)
//   tenants/{tenantId}/financials/{id}    costs/income per event (members)
//
// Isolation: a signed-in user can only reach the tenant named in their own
// users/{uid} doc. Plan/status live on the tenant doc, which only platform
// admins can write — a company can't upgrade or un-suspend itself.
// Suspended tenants are read-only. Staff can't change settings/categories.
// Tests: tests/firestore.rules.test.js (run against the emulator).
// ============================================================
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() {
      return request.auth != null;
    }
    function isPlatformAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid));
    }
    function hasProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isMember(tenantId) {
      return hasProfile() && me().tenantId == tenantId;
    }
    function isOwner(tenantId) {
      return isMember(tenantId) && me().role == 'owner';
    }
    function tenantActive(tenantId) {
      return get(/databases/$(database)/documents/tenants/$(tenantId)).data.status == 'active';
    }

    function isInvitee(email) {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == email;
    }
    // Public sign-up: a signed-in, verified user with no company yet creates
    // a brand-new tenant they own, on the free pilot plan, status active.
    function creatingOwnTenant(tenantId) {
      return signedIn()
        && request.auth.token.email_verified == true
        && !hasProfile()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.plan == 'trial'
        && request.resource.data.keys().hasOnly(['name', 'ownerUid', 'ownerEmail', 'ownerPhone', 'recoveryEmail', 'plan', 'status', 'createdAt', 'acceptedTermsAt']);
    }
    // ...and, in the same batch, the users/{uid} doc making them its owner.
    function joiningAsNewOwner(uid) {
      let tenantPath = /databases/$(database)/documents/tenants/$(request.resource.data.tenantId);
      return signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'owner'
        && !exists(tenantPath)
        && getAfter(tenantPath).data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['tenantId', 'role', 'name', 'email', 'joinedAt']);
    }

    // Self-join: no existing membership, an invite for my verified email
    // exists, and the new users/{uid} doc copies exactly its tenant + role.
    function joiningViaInvite(uid) {
      let inviteId = request.auth.token.email.lower();
      let invitePath = /databases/$(database)/documents/invites/$(inviteId);
      return signedIn()
        && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && exists(invitePath)
        && request.resource.data.tenantId == get(invitePath).data.tenantId
        && request.resource.data.role == get(invitePath).data.role
        && request.resource.data.keys().hasOnly(['tenantId', 'role', 'name', 'email', 'joinedAt']);
    }

    // ---------- platform admins (EventScope staff) ----------
    // Added/removed by hand in the Firebase console, never from the app.
    match /platformAdmins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ---------- user → tenant membership ----------
    // Read: yourself, the owner of your tenant (team list), or a platform admin.
    // Create: a platform admin, OR the signed-in user joining via an invite
    //   addressed to their Google-verified email (role/tenant must match it).
    // Delete: a platform admin, or the tenant owner removing a staff member.
    // Update: platform admins only (nobody can change their own role/tenant).
    match /users/{uid} {
      allow read: if signedIn() && (
        request.auth.uid == uid
        || isPlatformAdmin()
        || isOwner(resource.data.tenantId)
      );
      allow create: if isPlatformAdmin() || joiningViaInvite(uid) || joiningAsNewOwner(uid);
      allow update: if isPlatformAdmin();
      allow delete: if isPlatformAdmin()
        || (isOwner(resource.data.tenantId) && resource.data.role == 'staff' && uid != request.auth.uid);
    }

    // ---------- teammate invites ----------
    // Keyed by the invitee's email (lower-case). The owner creates/cancels
    // invites for their own tenant (staff role only). The invitee can read
    // and consume (delete) the invite addressed to their verified email.
    match /invites/{email} {
      allow read: if isPlatformAdmin()
        || isOwner(resource.data.tenantId)
        || isInvitee(email);
      allow create: if isOwner(request.resource.data.tenantId)
        && tenantActive(request.resource.data.tenantId)
        && request.resource.data.role == 'staff'
        && email == email.lower();
      // Re-inviting overwrites only your own tenant's invite, never another's.
      allow update: if isOwner(resource.data.tenantId)
        && request.resource.data.tenantId == resource.data.tenantId
        && request.resource.data.role == 'staff';
      allow delete: if isPlatformAdmin()
        || isOwner(resource.data.tenantId)
        || isInvitee(email);
    }

    // ---------- tenants ----------
    match /tenants/{tenantId} {
      allow read: if isMember(tenantId) || isPlatformAdmin();
      allow create: if isPlatformAdmin() || creatingOwnTenant(tenantId);
      allow update, delete: if isPlatformAdmin();

      // Company profile, bank details, invoice settings, categories: owner only.
      match /config/{docId} {
        allow read: if isMember(tenantId) || isPlatformAdmin();
        allow write: if (isOwner(tenantId) && tenantActive(tenantId)) || isPlatformAdmin();
      }

      // Costs/income per event (Job Log): any member reads and edits, like
      // events. Reports/profit views are owner-only in the app.
      match /financials/{eventId} {
        allow read: if isMember(tenantId) || isPlatformAdmin();
        allow write: if (isMember(tenantId) && tenantActive(tenantId)) || isPlatformAdmin();
      }

      // Events/drafts: any member, while the tenant is active.
      match /events/{eventId} {
        allow read: if isMember(tenantId) || isPlatformAdmin();
        allow write: if (isMember(tenantId) && tenantActive(tenantId)) || isPlatformAdmin();
      }
    }
  }
}
