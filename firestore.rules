// ============================================================
// EventScope — Firestore Security Rules (multi-tenant)
//
// These rules are what actually protect data — the app's own permission
// checks are only for a good UI. NOT auto-deployed by this repo: paste into
// Firebase Console → Firestore Database → Rules, or run
// `firebase deploy --only firestore:rules`.
//
// Keep in sync with the paths in src/context/AppContext.jsx:
//   platformAdmins/{uid}                     EventScope staff (managed in the console)
//   users/{uid}                              { tenantId, role: 'owner'|'staff', name, email, joinedAt }
//   invites/{email}                          pending invite { tenantId, role, ... } — owners invite staff; admins may invite owners
//   tenants/{tenantId}                       { name, plan, status: 'active'|'suspended', ownerUid, ownerEmail, ... }
//   tenants/{tenantId}/private/contact       owner's backup email + phone (owner + admins only)
//   tenants/{tenantId}/config/{doc}          settings | categories | jobLog (owner-editable)
//   tenants/{tenantId}/events/{eventId}      events/drafts (members)
//   tenants/{tenantId}/financials/{eventId}  Job Log costs/income/notes per event (members)
//
// Guarantees (each covered by tests/firestore.rules.test.mjs):
//   - A login only ever reaches the tenant named in its own users/{uid}.
//   - Plan/status are platform-controlled: a company can't upgrade or
//     un-suspend itself. Suspended companies are read-only.
//   - Staff can't change settings/categories/columns or manage the team.
//   - Nobody can change their own role or company, or make themselves admin.
//   - Joining a company needs an invite addressed to your verified Google email;
//     creating one needs a verified email and no existing company.
// ============================================================
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPERS — WHO IS ASKING
    // ============================================================

    function signedIn() {
      return request.auth != null;
    }
    function verifiedEmail() {
      return signedIn() && request.auth.token.email_verified == true;
    }
    // Full document path from a relative one, e.g. docPath('users/' + uid)
    function docPath(p) {
      return path('/databases/' + database + '/documents/' + p);
    }
    function isPlatformAdmin() {
      return signedIn() && exists(docPath('platformAdmins/' + request.auth.uid));
    }
    function hasProfile() {
      return signedIn() && exists(docPath('users/' + request.auth.uid));
    }
    function me() {
      return get(docPath('users/' + request.auth.uid)).data;
    }
    function isMember(tenantId) {
      return hasProfile() && me().tenantId == tenantId;
    }
    function isOwner(tenantId) {
      return isMember(tenantId) && me().role == 'owner';
    }
    function tenantActive(tenantId) {
      return get(docPath('tenants/' + tenantId)).data.status == 'active';
    }
    function isInvitee(email) {
      return verifiedEmail() && request.auth.token.email.lower() == email;
    }

    // ============================================================
    // HELPERS — JOINING / CREATING A COMPANY
    // ============================================================

    // Self-join: an invite for my verified email exists, and the new
    // users/{uid} doc copies exactly its tenant + role.
    function joiningViaInvite(uid) {
      let invite = docPath('invites/' + request.auth.token.email.lower());
      return verifiedEmail()
        && request.auth.uid == uid
        && exists(invite)
        && request.resource.data.tenantId == get(invite).data.tenantId
        && request.resource.data.role == get(invite).data.role
        && request.resource.data.keys().hasOnly(['tenantId', 'role', 'name', 'email', 'joinedAt']);
    }

    // Public sign-up, part 1: a verified login with no company creates a
    // brand-new tenant it owns, on the free pilot, active — and (same batch)
    // the users/{uid} link making it the owner, so no orphan companies.
    function creatingOwnTenant(tenantId) {
      let myLinkAfter = getAfter(docPath('users/' + request.auth.uid)).data;
      return verifiedEmail()
        && !hasProfile()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.plan == 'trial'
        && request.resource.data.keys().hasOnly(['name', 'ownerUid', 'ownerEmail', 'plan', 'status', 'createdAt', 'acceptedTermsAt'])
        && myLinkAfter.tenantId == tenantId
        && myLinkAfter.role == 'owner';
    }

    // Public sign-up, part 2: the users/{uid} doc for the brand-new tenant.
    function joiningAsNewOwner(uid) {
      let tenant = docPath('tenants/' + request.resource.data.tenantId);
      return signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'owner'
        && !exists(tenant)
        && getAfter(tenant).data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['tenantId', 'role', 'name', 'email', 'joinedAt']);
    }

    // Public sign-up, part 3: the owner's private contact record, created
    // in the same batch as the brand-new tenant.
    function creatingContactForNewTenant(tenantId) {
      let tenant = docPath('tenants/' + tenantId);
      return signedIn()
        && !exists(tenant)
        && getAfter(tenant).data.ownerUid == request.auth.uid;
    }

    // Platform admin adding people to a company (e.g. "Import company"):
    // may invite as owner or staff, still keyed by lower-case email.
    function adminInvite(email) {
      return isPlatformAdmin()
        && email == email.lower()
        && request.resource.data.role in ['owner', 'staff'];
    }

    // ============================================================
    // PLATFORM ADMINS (EventScope staff)
    // Added/removed by hand in the Firebase console, never from the app.
    // ============================================================
    match /platformAdmins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ============================================================
    // USERS — login → tenant + role
    // Read: yourself, your tenant's owner (team list), or a platform admin.
    // Create: admin, invite self-join, or the owner link at sign-up.
    // Update: admins only — nobody changes their own role or company.
    // Delete: admin, or the owner removing one of their staff (not themselves).
    // ============================================================
    match /users/{uid} {
      allow read: if signedIn() && (
        request.auth.uid == uid
        || isPlatformAdmin()
        || isOwner(resource.data.tenantId)
      );
      allow create: if isPlatformAdmin() || joiningViaInvite(uid) || joiningAsNewOwner(uid);
      allow update: if isPlatformAdmin();
      allow delete: if isPlatformAdmin()
        || (isOwner(resource.data.tenantId) && resource.data.role == 'staff' && uid != request.auth.uid);
    }

    // ============================================================
    // INVITES — keyed by the invitee's lower-case email
    // The owner creates/cancels invites for their own active tenant (staff
    // role only); re-inviting can only overwrite their own tenant's invite.
    // A platform admin may also invite (owner or staff), e.g. when importing.
    // The invitee can read and consume the invite for their verified email.
    // ============================================================
    match /invites/{email} {
      allow read: if isPlatformAdmin()
        || isOwner(resource.data.tenantId)
        || isInvitee(email);
      allow create: if (isOwner(request.resource.data.tenantId)
          && tenantActive(request.resource.data.tenantId)
          && request.resource.data.role == 'staff'
          && email == email.lower())
        || adminInvite(email);
      allow update: if adminInvite(email)
        || (isOwner(resource.data.tenantId)
          && tenantActive(resource.data.tenantId)
          && request.resource.data.tenantId == resource.data.tenantId
          && request.resource.data.role == 'staff');
      allow delete: if isPlatformAdmin()
        || isOwner(resource.data.tenantId)
        || isInvitee(email);
    }

    // ============================================================
    // TENANTS (companies) and everything inside them
    // ============================================================
    match /tenants/{tenantId} {
      // Plan/status are platform-controlled
      allow read: if isMember(tenantId) || isPlatformAdmin();
      allow create: if isPlatformAdmin() || creatingOwnTenant(tenantId);
      allow update, delete: if isPlatformAdmin();

      // Owner's backup email + phone — never visible to staff
      match /private/{docId} {
        allow read: if isOwner(tenantId) || isPlatformAdmin();
        allow create: if isPlatformAdmin()
          || (docId == 'contact'
              && creatingContactForNewTenant(tenantId)
              && request.resource.data.keys().hasOnly(['phone', 'recoveryEmail']));
        allow update: if isPlatformAdmin() || (isOwner(tenantId) && tenantActive(tenantId));
        allow delete: if isPlatformAdmin();
      }

      // Company profile, bank details, invoice settings, services, Job Log columns
      match /config/{docId} {
        allow read: if isMember(tenantId) || isPlatformAdmin();
        allow write: if (isOwner(tenantId) && tenantActive(tenantId)) || isPlatformAdmin();
      }

      // Events/drafts — any member, while the company is active
      match /events/{eventId} {
        allow read: if isMember(tenantId) || isPlatformAdmin();
        allow write: if (isMember(tenantId) && tenantActive(tenantId)) || isPlatformAdmin();
      }

      // Job Log costs/income/notes — any member, like events
      // (Reports/profit views are owner-only in the app)
      match /financials/{eventId} {
        allow read: if isMember(tenantId) || isPlatformAdmin();
        allow write: if (isMember(tenantId) && tenantActive(tenantId)) || isPlatformAdmin();
      }
    }
  }
}
